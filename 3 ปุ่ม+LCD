#include <Wire.h>
#include <LiquidCrystal_I2C.h>

#define IN1 26
#define IN2 27
#define ENA 25
#define BTN 14
#define LED 33   // เพิ่ม LED

LiquidCrystal_I2C lcd(0x27,16,2);

int state = 0;
bool lastBtn = HIGH;

void setMotor(){

  lcd.clear();
  lcd.setCursor(0,0);
  lcd.print("Motor Status:");

  if(state == 1){
    digitalWrite(IN1,HIGH);
    digitalWrite(IN2,LOW);
    digitalWrite(LED,HIGH);   // LED ติด
    lcd.setCursor(0,1);
    lcd.print("LEFT");
  }
  else if(state == 2){
    digitalWrite(IN1,LOW);
    digitalWrite(IN2,HIGH);
    digitalWrite(LED,HIGH);   // LED ติด
    lcd.setCursor(0,1);
    lcd.print("RIGHT");
  }
  else{
    digitalWrite(IN1,LOW);
    digitalWrite(IN2,LOW);
    digitalWrite(LED,LOW);    // LED ดับ
    lcd.setCursor(0,1);
    lcd.print("STOP");
  }
}

void setup(){
  pinMode(IN1,OUTPUT);
  pinMode(IN2,OUTPUT);
  pinMode(ENA,OUTPUT);
  pinMode(BTN,INPUT_PULLUP);
  pinMode(LED,OUTPUT);   // เพิ่ม

  digitalWrite(ENA,HIGH);

  lcd.init();
  lcd.backlight();

  setMotor();
}

void loop(){
  bool btn = digitalRead(BTN);

  if(lastBtn==HIGH && btn==LOW){
    state++;
    if(state>2) state=0;
    setMotor();
    delay(200);
  }

  lastBtn = btn;
}
